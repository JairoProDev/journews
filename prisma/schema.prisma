// JourNews Database Schema
// Diseñado para soportar la plataforma de noticias verificadas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// USUARIOS Y AUTENTICACIÓN
// ============================================

enum UserRole {
  USER      // Consumidor regular
  CREATOR   // Periodista/Creador de contenido
  ADMIN     // Administrador de plataforma
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?   // Para auth con credenciales
  role          UserRole  @default(USER)

  // Información de perfil
  bio           String?
  location      String?
  website       String?

  // Suscripción
  subscription  SubscriptionTier @default(FREE)
  subscriptionExpires DateTime?

  // Preferencias
  interests     String[]  // Temas de interés
  followedCreators Creator[] @relation("UserFollows")

  // Actividad
  viewedDossiers DossierView[]
  savedDossiers  SavedDossier[]
  reactions      Reaction[]

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations NextAuth
  accounts      Account[]
  sessions      Session[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// ============================================
// CREADORES/PERIODISTAS
// ============================================

enum CreatorStatus {
  PENDING     // En revisión
  VERIFIED    // Verificado y activo
  SUSPENDED   // Suspendido temporalmente
  BANNED      // Baneado permanentemente
}

model Creator {
  id              String         @id @default(cuid())
  userId          String?        @unique
  user            User?          @relation("UserFollows", fields: [userId], references: [id])

  // Información profesional
  displayName     String
  email           String         @unique
  bio             String?
  profileImage    String?
  coverImage      String?

  // Verificación y credibilidad
  status          CreatorStatus  @default(PENDING)
  verified        Boolean        @default(false)
  verifiedAt      DateTime?
  credibilityScore Float         @default(0) // 0-100

  // Información profesional
  organization    String?        // Medio al que pertenece
  title           String?        // Ej: "Periodista de Investigación"
  expertise       String[]       // Áreas de especialización
  yearsExperience Int?

  // Redes sociales (para verificación)
  twitterHandle   String?
  linkedinUrl     String?
  instagramHandle String?

  // Métricas
  totalDossiers   Int            @default(0)
  totalViews      Int            @default(0)
  followerCount   Int            @default(0)

  // Contenido creado
  dossiers        Dossier[]
  newsItems       NewsItem[]

  // Timestamps
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([email])
  @@index([status])
  @@index([verified])
  @@map("creators")
}

// ============================================
// DOSSIERS (Historias Completas)
// ============================================

enum DossierStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum DossierCategory {
  POLITICS
  ECONOMY
  TECHNOLOGY
  SCIENCE
  HEALTH
  EDUCATION
  ENVIRONMENT
  CULTURE
  SPORTS
  WORLD
  LOCAL
  BREAKING
}

model Dossier {
  id              String          @id @default(cuid())

  // Metadata básica
  title           String
  slug            String          @unique
  description     String
  coverImage      String?

  // Clasificación
  category        DossierCategory
  tags            String[]
  location        String?         // Ej: "Cusco, Perú"

  // Estado y publicación
  status          DossierStatus   @default(DRAFT)
  publishedAt     DateTime?

  // Creador
  creatorId       String
  creator         Creator         @relation(fields: [creatorId], references: [id])

  // Contenido del Dossier
  newsItems       NewsItem[]      // Piezas de contenido (videos, artículos)
  timeline        TimelineEvent[] // Cronología de eventos
  keyFigures      KeyFigure[]     // Personas clave involucradas
  sources         DossierSource[] // Fuentes verificadas

  // JournScore (Sistema de Credibilidad)
  journScore      Float           @default(0) // 0-100
  verificationStatus String        @default("unverified") // unverified, in_review, verified
  verifiedBy      String?         // ID del verificador humano
  verifiedAt      DateTime?

  // Análisis de sesgo
  biasScore       Float?          // -100 (muy izquierda) a +100 (muy derecha)
  biasAnalysis    Json?           // Análisis detallado de sesgo

  // Métricas
  viewCount       Int             @default(0)
  saveCount       Int             @default(0)
  shareCount      Int             @default(0)

  // Relaciones
  views           DossierView[]
  saves           SavedDossier[]
  reactions       Reaction[]

  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([creatorId])
  @@index([publishedAt])
  @@map("dossiers")
}

// ============================================
// NEWS ITEMS (Piezas de contenido)
// ============================================

enum NewsItemType {
  VIDEO
  ARTICLE
  INFOGRAPHIC
  AUDIO
  IMAGE_GALLERY
  LIVE_STREAM
}

model NewsItem {
  id              String        @id @default(cuid())

  // Relaciones
  dossierId       String
  dossier         Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  creatorId       String
  creator         Creator       @relation(fields: [creatorId], references: [id])

  // Tipo y contenido
  type            NewsItemType
  title           String?
  content         String?       // Texto del artículo o descripción
  mediaUrl        String?       // URL del video/audio/imagen
  thumbnailUrl    String?
  duration        Int?          // Duración en segundos (para video/audio)

  // Metadata
  transcript      String?       // Transcripción de video/audio
  altText         String?       // Para accesibilidad

  // Orden en el Dossier
  order           Int           @default(0)

  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([dossierId])
  @@index([creatorId])
  @@index([type])
  @@map("news_items")
}

// ============================================
// TIMELINE (Cronología de eventos)
// ============================================

model TimelineEvent {
  id              String        @id @default(cuid())

  dossierId       String
  dossier         Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  // Contenido del evento
  title           String
  description     String
  eventDate       DateTime      // Fecha del evento real

  // Media asociado
  imageUrl        String?
  videoUrl        String?

  // Fuentes
  sourceUrl       String?
  sourceName      String?

  // Orden en la cronología
  order           Int           @default(0)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([dossierId])
  @@index([eventDate])
  @@map("timeline_events")
}

// ============================================
// KEY FIGURES (Personas clave)
// ============================================

model KeyFigure {
  id              String        @id @default(cuid())

  dossierId       String
  dossier         Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  // Información de la persona
  name            String
  role            String        // Ej: "Presidente", "CEO", "Testigo"
  bio             String?
  imageUrl        String?

  // Enlaces
  wikipediaUrl    String?
  socialMediaUrls Json?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([dossierId])
  @@map("key_figures")
}

// ============================================
// SOURCES (Fuentes)
// ============================================

enum SourceType {
  OFFICIAL_DOCUMENT
  NEWS_AGENCY
  EXPERT_TESTIMONY
  WITNESS_ACCOUNT
  RESEARCH_PAPER
  GOVERNMENT_SOURCE
  NGO_REPORT
  OTHER
}

model Source {
  id              String          @id @default(cuid())

  // Información de la fuente
  name            String
  type            SourceType
  url             String?
  credibilityScore Float          @default(50) // 0-100

  // Metadata
  description     String?
  logoUrl         String?

  // Uso en Dossiers
  dossiers        DossierSource[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("sources")
}

model DossierSource {
  id              String        @id @default(cuid())

  dossierId       String
  dossier         Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  sourceId        String
  source          Source        @relation(fields: [sourceId], references: [id])

  // Contexto de uso
  relevance       String?       // Por qué es relevante esta fuente
  quotedText      String?       // Texto citado de la fuente

  createdAt       DateTime      @default(now())

  @@unique([dossierId, sourceId])
  @@map("dossier_sources")
}

// ============================================
// INTERACCIONES DE USUARIOS
// ============================================

model DossierView {
  id              String        @id @default(cuid())

  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  dossierId       String
  dossier         Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  // Metadata de la vista
  viewDuration    Int?          // Segundos
  completedView   Boolean       @default(false)

  // Device info (para analytics)
  userAgent       String?
  ipAddress       String?

  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([dossierId])
  @@index([createdAt])
  @@map("dossier_views")
}

model SavedDossier {
  id              String        @id @default(cuid())

  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  dossierId       String
  dossier         Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  createdAt       DateTime      @default(now())

  @@unique([userId, dossierId])
  @@index([userId])
  @@map("saved_dossiers")
}

enum ReactionType {
  INSIGHTFUL
  IMPORTANT
  CONCERNING
  INSPIRING
}

model Reaction {
  id              String        @id @default(cuid())

  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  dossierId       String
  dossier         Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  type            ReactionType

  createdAt       DateTime      @default(now())

  @@unique([userId, dossierId, type])
  @@index([dossierId])
  @@map("reactions")
}

// ============================================
// NEXTAUTH MODELS
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
